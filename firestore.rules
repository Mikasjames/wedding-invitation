rules_version = '2';

/**
 * Guest RSVP rules.
 *
 * There is no authentication. The security model is that the invite code *is*
 * the capability: a document is at `rsvps/{code}`, `list` is denied outright so
 * the collection cannot be dumped, and 10 characters of Crockford base32
 * (~1.13e15 combinations) makes guessing one infeasible. Firestore rules cannot
 * rate-limit, so the code length in `src/lib/rsvp/codes.ts` is load-bearing —
 * shortening it reopens enumeration, and nothing in this file would notice.
 *
 * Two things to preserve if this is ever edited:
 *
 * 1. Never add a catch-all `match /{document=**} { allow read, write: if true }`.
 *    Rules are permissive-OR across match blocks, so one catch-all silently
 *    overrides everything above. A future `/admin` needs a narrow branch
 *    gated on a custom claim, added as its own `match`.
 *
 * 2. Never query a guest-reachable collection. Every guest operation is a point
 *    `get()`/`update()` on a document ID. A `where()` would need a composite
 *    index *and* would reopen enumeration, which `allow list: if false` is
 *    currently the only thing preventing.
 *
 * Note the client must read with `doc(db, 'rsvps', code).get()`. A query such as
 * `where(documentId(), '==', code)` is a `list` operation and is denied.
 *
 * DEPLOYING THIS
 *
 * A Firestore database has exactly one rules file, so this either becomes the
 * whole file or its `match /rsvps/{code}` block is lifted into one that already
 * exists. To add it to an existing ruleset, copy the `match` block and the five
 * functions above it — nothing in this file depends on being the only content.
 *
 * If the ruleset already has `function isAdmin()`, keep it as it is. This file
 * deliberately has no admin branch at all: there is no authenticated user in the
 * guest flow, and adding one "for later" is how a guest-only rule quietly turns
 * into a catch-all.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /rsvps/{code} {

      // Mirrors CODE_PATTERN in src/lib/rsvp/codes.ts. Kept as a literal because
      // rules cannot import it, and kept narrow so a future guest-reachable
      // document under a different id shape is denied rather than assumed safe.
      function isKnownCode() {
        return code.matches('^[0-9A-HJ-KM-NP-TV-Z]{10}$');
      }

      // The line that separates "change my answer" from "change the invitation".
      // Must stay in step with RESPONSE_FIELDS in src/lib/rsvp/types.ts.
      function onlyResponseFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'partySize', 'attendeeNames',
          'dietaryNotes', 'message', 'respondedAt'
        ]);
      }

      // Enforced here rather than in the UI on purpose: the stepper can be
      // bypassed by anything that speaks the Firestore protocol directly. If a
      // guest's household is allotted four seats, four is the ceiling no matter
      // what the request body says.
      function isWellFormed() {
        let r = request.resource.data;
        return r.status in ['pending', 'attending', 'declined']
          && r.partySize is int
          && r.partySize >= 0
          && r.partySize <= resource.data.seatsAllocated
          && (r.status == 'attending' ? r.partySize >= 1 : r.partySize == 0);
      }

      // A guest may revise their answer right up to the cutoff and not one
      // instant after. `request.time` is the server clock, so this holds even
      // though the client can set its own `respondedAt`.
      //
      // Update CUTOFF when the couple's deadline changes; it is a literal
      // because rules cannot read a document's own data for a comparison against
      // the current time without granting the guest more than they need.
      function isBeforeCutoff() {
        return resource.data.status == 'pending'
          || request.time < timestamp('2027-01-15T00:00:00+08:00');
      }

      allow get: if isKnownCode() && resource.data.active == true;

      allow list: if false;

      // Every document already exists from the seed, so nothing is created at
      // runtime. Without this, a guest could mint a household of their own.
      allow create: if false;

      // A printed card cannot be recalled. Households are archived by the seed
      // script setting `active: false`, never removed.
      allow delete: if false;

      allow update: if isKnownCode()
                    && resource.data.active == true
                    && onlyResponseFieldsChanged()
                    && isWellFormed()
                    && isBeforeCutoff();
    }
  }
}