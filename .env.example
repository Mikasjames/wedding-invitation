# Firebase Web SDK configuration.
#
# These are not secrets. The Firebase web config is designed to ship inside
# client bundles and is protected by Firestore security rules and App Check,
# not by being hidden. Copy this file to `.env` and fill it in from
# Firebase console → Project settings → Your apps → Web app → SDK setup.
#
# PUBLIC_FIREBASE_AUTH_DOMAIN is only needed by /admin — the invitation's RSVP
# flow works without it — so `isConfigured()` deliberately does not require it.
# `isAuthConfigured()` does, and /admin reports itself unconfigured rather than
# failing silently at the sign-in button.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# Google Analytics id. Read into the config but unused — analytics was not part
# of the ask. Present so turning it on later is a one-line change.
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Which Firestore database to open.
#
# A project can hold several side by side, and the Web SDK will not guess:
# `getFirestore(app)` always connects to `(default)`. This project created
# `base`, so leaving this blank makes every read fail with
# "Database '(default)' not found" — which reads like an outage and is not one.
#
# Must match what `pnpm seed` writes to, or the dashboard shows all zeros.
PUBLIC_FIRESTORE_DATABASE_ID=base

# Absolute path to a Firebase service-account key. Used only by
# `pnpm seed`, never shipped to the browser. See scripts/README.md.
# FIREBASE_SERVICE_ACCOUNT=/abs/path/to/service-account.json